# Kélia Priscila — .htaccess
# Proteção de pastas sensíveis + headers de segurança.

Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueia acesso público a pastas internas e documentação
    RewriteRule ^(config|includes|storage|agents)(/|$) - [F,L]
</IfModule>

# Arquivos sensíveis e ocultos (.env, .htaccess, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
